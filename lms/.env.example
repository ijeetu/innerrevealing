# Inner Revealing web application
SITE_URL=https://ir.vishwalabs.com
NEXT_PUBLIC_API_URL=https://ir.vishwalabs.com
NEXT_PUBLIC_END_POINT=api
NEXT_PUBLIC_WEB_URL=https://ir.vishwalabs.com
NEXT_PUBLIC_WEB_NAME="Inner Revealing"
NEXT_PUBLIC_WEB_LOGO=/inner-revealing-logo.png
NEXT_PUBLIC_WEB_VERSION=1.1.2
NEXT_PUBLIC_LOADER_COLOR="#5700b8"
NEXT_PUBLIC_TITLE="Inner Revealing | Meditation & Yoga"
NEXT_PUBLIC_DESCRIPTION="Explore meditation, yoga and personal growth with Inner Revealing."
NEXT_PUBLIC_KEYWORDS="Inner Revealing, meditation, yoga, mindfulness"
NEXT_PUBLIC_SEO=true
NEXT_PUBLIC_DEMO=false
NEXT_PUBLIC_LOAD_MIN=5
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=in
NEXT_PUBLIC_COUNTRY_DIAL_CODE=91

# MySQL: server-only. Never prefix these with NEXT_PUBLIC_.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=irlmsdb
DB_USER=irlmsweb
DB_PASSWORD=

# Generate a random 32-byte encryption key, e.g. openssl rand -hex 32.
# Keep this stable; it encrypts private SMTP/payment credentials in MySQL.
APP_ENCRYPTION_KEY=
UPLOAD_DIR=/home/innerrevealing/shared/uploads

# Optional analytics, disabled by default
NEXT_PUBLIC_CLARITY_PROJECT_ID=
